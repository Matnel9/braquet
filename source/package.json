{
 "name": "braquet",
 "productName": "Braquet",
 "version": "1.0.1",
 "description": "Analyse et coaching cycliste",
 "author": "Mathis",
 "main": "app/main.js",
 "build": {
  "appId": "fr.braquet.app",
  "productName": "Braquet",
  "directories": {
   "output": "dist"
  },
  "files": [
   "app/**/*"
  ],
  "asar": true,
  "electronLanguages": [
   "fr",
   "en-US"
  ],
  "win": {
   "target": [
    "dir"
   ],
   "signAndEditExecutable": false
  },
  "mac": {
   "target": [
    "zip"
   ],
   "identity": null,
   "icon": "build-icon.icns"
  }
 },
 "devDependencies": {}
}